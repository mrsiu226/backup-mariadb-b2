# ============================================================
# backup-mariadb-b2 | Config Template
# Copy file này thành config.env rồi điền thông tin thật
# cp config.example.env config.env
# ============================================================

# --- Backblaze B2 -----------------------------------------
B2_ACCOUNT_ID="your_account_id_here"
B2_APPLICATION_KEY="your_application_key_here"
B2_BUCKET="your-bucket-name"
# Tên remote rclone sẽ tạo (mặc định: b2)
B2_REMOTE_NAME="b2"

# --- MariaDB Backup User ----------------------------------
# User riêng cho backup (KHÔNG dùng root)
MYSQL_BACKUP_USER="backup_user"
MYSQL_BACKUP_PASSWORD="CHANGE_ME_strong_password_here"
MYSQL_HOST="localhost"

# --- Backup Settings --------------------------------------
# Thư mục lưu backup local
BACKUP_DIR="/root/backups/mariadb"

# Databases LOẠI TRỪ (system DBs)
EXCLUDE_DBS="information_schema performance_schema sys mysql"

# Giữ backup local bao nhiêu ngày
LOCAL_RETENTION_DAYS=3

# Giữ backup trên B2 bao nhiêu ngày
B2_RETENTION_DAYS=30

# --- Cronjob ----------------------------------------------
# Giờ chạy backup (cron format: phút giờ)
CRON_MINUTE=30
CRON_HOUR=2

# --- Log --------------------------------------------------
LOG_DIR="/root/logs"

# --- Telegram Notification (để trống nếu không dùng) ------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Source Code Backup (HostVN websites) ------------------
# Bật/tắt backup source code (yes/no). Tự nhận diện HostVN
# bản cũ (/var/hostvn/users) và bản mới (/var/hostvn/data/websites)
ENABLE_SOURCE_BACKUP="no"

# Thư mục lưu backup source local
SOURCE_BACKUP_DIR="/root/backups/source"

# Domain loại trừ, không backup (cách nhau bởi khoảng trắng)
SOURCE_EXCLUDE_DOMAINS=""

# Thư mục/pattern loại trừ khi zip (cách nhau bởi khoảng trắng)
# - tên thư mục: loại ở mọi cấp; chứa * : khớp file; bắt đầu bằng / : chỉ ở gốc site (vd /vendor)
# - muốn bỏ video/zip/sql thì tự thêm: *.mp4 *.zip *.sql
SOURCE_EXCLUDE_PATTERNS="/vendor node_modules .git .svn .cache cache tmp logs *.log error_log* storage/framework/sessions storage/framework/views storage/debugbar var/log .next/cache wp-content/updraft wp-content/backups wp-content/upgrade wp-content/wflogs wp-content/et-cache wp-content/ai1wm-backups wp-content/wp-snapshots wp-content/backups-dup-lite wp-content/wpvividbackups"

# Chu kỳ backup source (ngày): 1=hàng ngày, 3, 5, 7=hàng tuần...
# DB vẫn backup hàng ngày. Server ít dung lượng nên đặt 3-7.
SOURCE_BACKUP_INTERVAL_DAYS=1

# Giữ backup source local bao nhiêu ngày
SOURCE_LOCAL_RETENTION_DAYS=3

# Giữ backup source trên B2 bao nhiêu ngày
SOURCE_B2_RETENTION_DAYS=14
